   "zh": "看起来可以被击破。"
  },
  "fixenvprompt": {
   "en": "Looks fixable.",
   "zh": "看起来可以被修理。"
  },
  "revealenvprompt": {
   "en": "Can be revealed.",
   "zh": "可以被揭示。"
  },
