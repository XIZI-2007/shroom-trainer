   "zh": "可以用于开锁。"
  },
  "dig": {
   "en": "Can be used on dig sites.",
   "zh": "可以用于挖掘点。"
  },
  "break": {
   "en": "Used to break things.",
   "zh": "用于击破物品。"
  },
  "fix": {
   "en": "Used to repair things.",
   "zh": "用于修理物品。"
  },
  "reveal": {
   "en": "Reveals something that is obscured.",
   "zh": "揭示被遮蔽的事物。"
  },
  "ignite": {
   "en": "LET IT BURN!",
   "zh": "烧吧，烧吧！"
  },
  "feed": {
   "en": "Everyone has to eat at some point.",
   "zh": "总有要吃东西的时候。"
  },
  "unlockenvprompt": {
   "en": "Looks unlockable.",
   "zh": "看起来可以被解锁。"
  },
  "digenvprompt": {
   "en": "Something is hidden here.\\nLooks diggable.",
   "zh": "这里藏了什么东西。\\n可以挖一挖试试。"
  },
  "breakenvprompt": {
