# ── 打包产物与中间产物（随时可用「重新打包.bat」重建，不进仓库）──
dist/
build/
*.pkg

# ── Python 缓存 ──
__pycache__/
*.py[cod]
*$py.class

# ── 临时文件 ──
*.tmp
*.bak
*.log

# ── 编辑器 / 系统 ──
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# ── 截图（SHROOM_UI_SHOT=1 时才生成，属临时产物）──
tools/*.png

# ── 凭据类，绝不入库 ──
*.token
*.pat
.git-credentials
credentials.*
